# =============================================================================
#  Nginx - Frontend Angular 17 (Carvajal E-commerce)
#
#  La imagen oficial de nginx procesa /etc/nginx/templates/*.template con
#  envsubst al arrancar, sustituyendo ${PORT}, ${BACKEND_URL} y
#  ${NGINX_LOCAL_RESOLVERS} (esta ultima la exporta el propio entrypoint a
#  partir de /etc/resolv.conf).
#  NGINX_ENVSUBST_FILTER limita la sustitucion a esas tres variables para que
#  las variables propias de nginx ($uri, $host, ...) se respeten tal cual.
# =============================================================================

server {
    # 80 en local (docker-compose); Railway inyecta su propio PORT.
    listen      ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # SPA: cualquier ruta de Angular Router se resuelve contra index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy inverso hacia el backend. Al servir API y app en el MISMO origen,
    # el navegador no dispara preflight y CORS deja de ser un problema.
    # Requiere apiUrl: '' en environment.prod.ts (ver README, opcion A).
    # BACKEND_URL debe ir SIN barra final para conservar el prefijo /api.
    location /api/ {
        # El upstream se pasa por variable a proposito: asi nginx resuelve el
        # DNS en cada peticion (no al cargar la config). Sin esto, arrancar el
        # frontend con el backend caido aborta nginx con "host not found in
        # upstream" y el servicio entra en bucle de reinicio en Railway.
        resolver           ${NGINX_LOCAL_RESOLVERS} valid=10s;
        set $upstream      ${BACKEND_URL};
        proxy_pass         $upstream$request_uri;
        proxy_http_version 1.1;

        # $proxy_host, no $host: el Host debe ser el del upstream. Plataformas
        # como Render enrutan por nombre, y reenviar el host del frontend haria
        # que no encontrasen el servicio backend.
        proxy_set_header   Host              $proxy_host;
        # SNI, necesario cuando BACKEND_URL es https:// (dominios de Render).
        proxy_ssl_server_name on;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Authorization     $http_authorization;
        proxy_read_timeout 60s;
    }

    # Los bundles de Angular llevan hash en el nombre: cache agresiva.
    location ~* \.(?:js|css|woff2?|ttf|eot|png|jpe?g|gif|svg|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html nunca se cachea: es quien apunta a los bundles nuevos.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    gzip            on;
    gzip_vary       on;
    gzip_min_length 1024;
    gzip_types      text/plain text/css application/javascript application/json image/svg+xml;
}
